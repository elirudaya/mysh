<% content_for :title, "Гайды" %>

<h1>Гайды</h1>

<% if user_signed_in? && current_user.admin? %>
  <h2>Создать гайд</h2>
  <%= render "form", checklist: @checklist %>
<% end %>

<h2>Опубликованные гайды</h2>

<div id="checklists">
  <% if @checklists.any? %>
    <% @checklists.each do |checklist| %>
      <%= render checklist %>

      <p>
        <%= link_to "Посмотреть гайд", checklist_path(checklist) %>
      </p>

      <hr>
    <% end %>
  <% else %>
    <p>Пока нет опубликованных гайдов</p>
  <% end %>
</div>