<p><%= notice %></p>

<h1>Гайд</h1>

<%= render @checklist %>

<% if user_signed_in? && current_user.admin? %>
  <p>
    <%= link_to "Редактировать гайд", edit_checklist_path(@checklist) %>
  </p>

  <%= button_to "Удалить гайд",
                checklist_path(@checklist),
                method: :delete,
                data: { turbo_confirm: "Удалить этот гайд?" } %>
<% end %>

<p>
  <%= link_to "Вернуться к гайдам", checklists_path %>
</p>