<p style="color: green"><%= notice %></p>

<%= render @trip %>

<div>
  <% if user_signed_in? && @trip.user == current_user %>
    <%= link_to "Edit this trip", edit_trip_path(@trip) %> |
    <%= link_to "Destroy this trip", @trip, data: { turbo_method: :delete } %> |
  <% end %>

  <%= link_to "Back to trips", trips_path %>
</div>
