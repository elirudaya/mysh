<div id="<%= dom_id trip %>">
  <div>
    <strong>User:</strong>
    <%= trip.user.email %>
  </div>

  <div>
    <strong>Origin city:</strong>
    <%= trip.origin_city %>
  </div>

  <div>
    <strong>Destination city:</strong>
    <%= trip.destination_city %>
  </div>

  <div>
    <strong>Start date:</strong>
    <%= trip.start_date %>
  </div>

  <div>
    <strong>End date:</strong>
    <%= trip.end_date %>
  </div>

  <div>
    <strong>Trip type:</strong>
    <%= trip.trip_type %>
  </div>

  <div>
    <strong>Transport:</strong>
    <%= trip.transport %>
  </div>

</div>
