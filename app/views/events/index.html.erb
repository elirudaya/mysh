<% content_for :title, "Афиша" %>

<h1>Афиша</h1>

<% if user_signed_in? && current_user.admin? %>
  <h2>Создать мероприятие</h2>
  <%= render "form", event: @event %>
<% end %>

<h2>Опубликованные мероприятия</h2>

<div id="events">
  <% if @events.any? %>
    <% @events.each do |event| %>
      <%= render event %>

      <p>
        <%= link_to "Посмотреть мероприятие", event_path(event) %>
      </p>

      <hr>
    <% end %>
  <% else %>
    <p>Пока нет опубликованных мероприятий</p>
  <% end %>
</div>