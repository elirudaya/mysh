<div class="admin-content-inner">
  <div class="admin-posts-header">
    <h1 class="admin-page-title">
      <%= image_tag "admin-panel.svg", class: "admin-title-image", alt: "" %>
      Мероприятия
    </h1>

    <%= link_to "Добавить мероприятие",
        new_admin_event_path,
        class: "admin-add-button" %>
  </div>

  <section class="admin-card">
    <h2>Все мероприятия</h2>

    <% if @events.any? %>
      <% @events.each do |event| %>
        <article class="admin-post">
          <h2>
            <%= link_to event.title, admin_event_path(event) %>
          </h2>

          <p>Дата: <%= event.date.strftime("%d.%m.%Y в %H:%M") %></p>
          <p>Место: <%= event.city %>, <%= event.address %></p>

          <% if event.image.attached? %>
            <%= image_tag event.image, class: "admin-list-image" %>
          <% end %>

          <p><%= truncate(event.description, length: 250) %></p>

          <%= button_to "Удалить мероприятие",
              admin_event_path(event),
              method: :delete,
              data: { turbo_confirm: "Удалить мероприятие?" },
              class: "admin-delete-button" %>
        </article>
      <% end %>
    <% else %>
      <p class="admin-empty">Мероприятий пока нет</p>
    <% end %>
  </section>
</div>
