<div id="<%= dom_id event %>">
  <div>
    <strong>User:</strong>
    <%= event.user_id %>
  </div>

  <div>
    <strong>Title:</strong>
    <%= event.title %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= event.description %>
  </div>

  <div>
    <strong>Date:</strong>
    <%= event.date %>
  </div>

  <div>
    <strong>City:</strong>
    <%= event.city %>
  </div>

  <div>
    <strong>Capacity:</strong>
    <%= event.capacity %>
  </div>

</div>
