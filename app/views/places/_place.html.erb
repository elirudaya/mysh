<div id="<%= dom_id place %>">
  <div>
    <strong>User:</strong>
    <%= place.user.email %>
  </div>

  <div>
    <strong>Name:</strong>
    <%= place.name %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= place.description %>
  </div>

  <div>
    <strong>City:</strong>
    <%= place.city %>
  </div>

  <div>
    <strong>Address:</strong>
    <%= place.address %>
  </div>

  <div>
    <strong>Category:</strong>
    <%= place.category %>
  </div>

</div>
