<p><%= notice %></p>

<h1>Место</h1>

<%= render @place %>

<% if user_signed_in? && current_user.admin? %>
  <p>
    <%= link_to "Редактировать место", edit_place_path(@place) %>
  </p>

  <%= button_to "Удалить место",
                place_path(@place),
                method: :delete,
                data: { turbo_confirm: "Удалить это место?" } %>
<% end %>

<p>
  <%= link_to "Вернуться к местам", places_path %>
</p>