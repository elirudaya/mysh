<% content_for :title, "Места" %>

<h1>Места</h1>

<% if user_signed_in? && current_user.admin? %>
  <h2>Создать место</h2>
  <%= render "form", place: @place %>
<% end %>

<h2>Опубликованные места</h2>

<div id="places">
  <% if @places.any? %>
    <% @places.each do |place| %>
      <%= render place %>

      <p>
        <%= link_to "Посмотреть место", place_path(place) %>
      </p>

      <hr>
    <% end %>
  <% else %>
    <p>Пока нет опубликованных мест</p>
  <% end %>
</div>