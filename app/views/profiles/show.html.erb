<h1>Профиль</h1>

<p>
  <strong>Email:</strong>
  <%= @profile.user.email %>
</p>

<p>
  <strong>Имя:</strong>
  <%= @profile.name %>
</p>

<p>
  <strong>Страна происхождения:</strong>
  <%= @profile.origin_country %>
</p>

<p>
  <strong>Город происхождения:</strong>
  <%= @profile.origin_city %>
</p>

<p>
  <strong>Текущая страна:</strong>
  <%= @profile.current_country %>
</p>

<p>
  <strong>Текущий город:</strong>
  <%= @profile.current_city %>
</p>

<% if user_signed_in? && @profile.user == current_user %>
  <%= link_to "Edit this profile", edit_profile_path(@profile) %>
<% end %>

<br><hr><br>

<h2>Интересы</h2>

<% @profile.user.user_interests.each do |user_interest| %>
  <p><%= user_interest.interest.name %></p>
<% end %>

<h2>Друзья</h2>

<% @profile.user.friendships.each do |friendship| %>
  <p>
    <%= friendship.friend_email %> —
    <%= friendship.status %>
  </p>
<% end %>

<h2>Подписки</h2>

<% @profile.user.subscriptions.each do |subscription| %>
  <p><%= subscription.name %></p>
<% end %>

<h2>Посты</h2>

<% @profile.user.posts.each do |post| %>
  <p>
    <%= link_to post.title, post_path(post) %>
  </p>
<% end %>