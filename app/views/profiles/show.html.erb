<main>
  <h1>Профиль</h1>

  <section>
    <h2>О себе</h2>

    <p>
      <strong>Имя:</strong>
      <%= @profile.name || "Не указано" %>
    </p>

    <p>
      <strong>Возраст:</strong>
      <%= @profile.age || "Не указан" %>
    </p>

    <p>
      <strong>Откуда:</strong>
      <%= [@profile.origin_city, @profile.origin_country]
            .reject(&:blank?).join(", ").presence || "Не указано" %>
    </p>

    <p>
      <strong>Сейчас проживает:</strong>
      <%= [@profile.current_city, @profile.current_country]
            .reject(&:blank?).join(", ").presence || "Не указано" %>
    </p>

    <p>
      <strong>Соцсети:</strong>
      <%= @profile.social.presence || "Не указаны" %>
    </p>
  </section>

  <section>
    <h2>Посты</h2>

    <% if @posts.any? %>
      <% @posts.each do |post| %>
        <p>
          <%= link_to post.title, post_path(post) %>
        </p>
      <% end %>
    <% else %>
      <p>Пока нет постов</p>
    <% end %>
  </section>

  <nav>
    <% if user_signed_in? && current_user == @profile.user %>
      <%= link_to "Редактировать профиль",
            edit_profile_path(@profile) %>
      |
    <% end %>

    <%= link_to "На главную", home_path %>
  </nav>
</main>
