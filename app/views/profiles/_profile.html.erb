<div id="<%= dom_id profile %>">
  <div>
    <strong>User:</strong>
    <%= profile.user_id %>
  </div>

  <div>
    <strong>Name:</strong>
    <%= profile.name %>
  </div>

  <div>
    <strong>Origin country:</strong>
    <%= profile.origin_country %>
  </div>

  <div>
    <strong>Origin city:</strong>
    <%= profile.origin_city %>
  </div>

  <div>
    <strong>Current country:</strong>
    <%= profile.current_country %>
  </div>

  <div>
    <strong>Current city:</strong>
    <%= profile.current_city %>
  </div>

</div>
