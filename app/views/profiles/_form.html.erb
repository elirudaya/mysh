<%= form_with(model: profile) do |form| %>

  <% if profile.errors.any? %>
    <div>
      <p>Проверь введенные данные:</p>

      <ul>
        <% profile.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "Имя:" %>
    <%= form.text_field :name,
          placeholder: "Алена" %>
  </div>

  <div>
    <%= form.label :age, "Возраст:" %>
    <%= form.number_field :age, min: 1, max: 120,
          placeholder: "27" %>
  </div>

  <div>
    <%= form.label :origin_country, "Страна до переезда:" %>
    <%= form.text_field :origin_country,
          placeholder: "Казахстан" %>
  </div>

  <div>
    <%= form.label :origin_city, "Город до переезда:" %>
    <%= form.text_field :origin_city,
          placeholder: "Павлодар" %>
  </div>

  <div>
    <%= form.label :current_country, "Страна сейчас:" %>
    <%= form.text_field :current_country,
          placeholder: "Россия" %>
  </div>

  <div>
    <%= form.label :current_city, "Город сейчас:" %>
    <%= form.text_field :current_city,
          placeholder: "Москва" %>
  </div>

  <div>
    <%= form.label :social, "Соцсети:" %>
    <%= form.text_field :social,
          placeholder: "t.me/username" %>
  </div>

  <p>
    <%= form.submit "Сохранить изменения" %>
  </p>

<% end %>
