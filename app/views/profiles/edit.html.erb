<main class="profile-page">
  <div class="profile-container">

    <h1>Редактирование профиля</h1>

    <p>
      Расскажи о себе, 
      данные отобразятся в твоем профиле
    </p>

    <%= render "form", profile: @profile %>

    <p>
      <%= link_to "Вернуться в профиль",
            profile_path(@profile) %>
    </p>

  </div>
</main>
