<header class="site-header">
  <nav class="site-menu">
    <div class="site-menu-left">
      <%= link_to "между", home_path, class: "site-logo" %>
    </div>

    <div class="site-menu-center">
      <%= link_to "О проекте", home_path %>
    </div>

    <div class="site-menu-right">
      <% if user_signed_in? && current_user.admin? %>
        <%= link_to "Управление", admin_path, class: "site-admin-link" %>

        <%= button_to "Выйти",
              destroy_user_session_path,
              method: :delete,
              class: "site-logout" %>
      <% end %>
    </div>
  </nav>
</header>
