<div>
  <p>
    <strong>
      <%= comment.user.profile&.name.presence ||
            "автор" %>:
    </strong>

    <%= comment.body %>
  </p>

  <% if user_signed_in? && comment.user == current_user %>
    <p>
      <%= link_to "Редактировать",
            edit_post_comment_path(comment.post, comment) %>
    </p>
  <% end %>

  <% if user_signed_in? && (comment.user == current_user || current_user.admin?) %>

    <%= button_to "Удалить комментарий",
          post_comment_path(comment.post, comment),
          method: :delete,
          data: { turbo_confirm: "Удалить комментарий?" } %>

  <% end %>
</div>

<hr>
