<h1>Редактировать комментарий</h1>

<%= form_with(
      model: [@post, @comment]
    ) do |form| %>

  <% if @comment.errors.any? %>
    <p>Проверь комментарий:</p>

    <ul>
      <% @comment.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <p>
    <%= form.label :body, "Текст комментария" %>
    <%= form.text_area :body, rows: 4, required: true %>
  </p>

  <p>
    <%= form.submit "Сохранить изменения" %>
  </p>

<% end %>

<p>
  <%= link_to "Вернуться к посту", post_path(@post) %>
</p>
