<%= form_with(model: post, class: "admin-post-form") do |form| %>
  <% if post.errors.any? %>
    <div class="admin-form-errors">
      <p>Проверь данные:</p>

      <ul>
        <% post.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="admin-form-field">
    <%= form.label :title, "Заголовок" %>
    <%= form.text_field :title,
        placeholder: "О чем хочешь рассказать?",
        required: true %>
  </div>

  <div class="admin-form-field">
    <%= form.label :body, "Текст публикации" %>
    <%= form.text_area :body,
        placeholder: "Расскажи свою историю...",
        rows: 5,
        required: true %>
  </div>

  <div class="admin-form-field">
    <%= form.label :image, "Добавить обложку" %>
    <div class="admin-image-upload">
      <%= form.file_field :image, accept: "image/jpeg,image/png,image/webp" %>

      <% if post.persisted? && post.image.attached? %>
        <%= image_tag post.image, class: "admin-image-preview" %>
      <% end %>
    </div>
  </div>

  <div class="admin-form-actions">
    <%= form.submit "Сохранить", class: "admin-save-button" %>

    <%= link_to "Назад к постам",
        current_user.admin? ? admin_posts_path : mine_posts_path,
        class: "admin-back-button" %>
  </div>
<% end %>
