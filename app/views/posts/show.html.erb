<h1><%= @post.title %></h1>

<p>
  Автор: <%= @post.user.profile&.name.presence || "автор" %>
</p>

<p><%= simple_format(@post.body) %></p>

<% if can?(:update, @post) %>
  <p><%= link_to "Редактировать пост", edit_post_path(@post) %></p>
<% end %>

<% if can?(:destroy, @post) %>
  <%= button_to "Удалить пост",
        post_path(@post),
        method: :delete,
        data: { turbo_confirm: "Удалить этот пост?" } %>
<% end %>

<hr>

<h2>Комментарии</h2>

<% if @post.comments.any? %>
  <%= render @post.comments %>
<% else %>
  <p>Пока нет комментариев</p>
<% end %>

<h3>Оставить комментарий</h3>
<%= render "comments/form" %>

<p><%= link_to "В ленту", posts_path %></p>