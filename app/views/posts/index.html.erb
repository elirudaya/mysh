<p style="color: green"><%= notice %></p>
<% content_for :title, "Лента" %>

<h1>Лента</h1>

<p><%= link_to "Написать пост", new_post_path %></p>
<p><%= link_to "Мои посты", mine_posts_path %></p>

<h2>Публикации</h2>

<div id="posts">
  <% if @posts.any? %>
    <% @posts.each do |post| %>
      <%= render post %>
      <p><%= link_to "Читать пост", post_path(post) %></p>
      <hr>
    <% end %>
  <% else %>
    <p>Пока нет публикаций</p>
  <% end %>
</div>