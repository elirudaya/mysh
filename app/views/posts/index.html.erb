<h1>Лента</h1>
<% if user_signed_in? %>
  <p>
    <%= link_to "Написать пост", new_post_path %>
    |
    <%= link_to "Мои посты", mine_posts_path %>
  </p>

  <% if current_user.admin? %>
    <p>
      <%= link_to "Посты на модерации",
            review_posts_path %>
    </p>
  <% end %>
<% else %>
  <p>
    <%= link_to "Войти", new_user_session_path %>,
    чтобы написать пост.
  </p>
<% end %>

<hr>

<% if @posts.any? %>
  <% @posts.each do |post| %>
    <article>
      <h2>
        <%= link_to post.title, post_path(post) %>
      </h2>

      <p>
        Автор:
        <%= post.user.profile&.name.presence ||
              "автор" %>
      </p>

      <p>
        <%= truncate(post.body, length: 200) %>
      </p>
    </article>

    <hr>
  <% end %>
<% else %>
  <p>Пока ничего не опубликовано</p>
<% end %>
