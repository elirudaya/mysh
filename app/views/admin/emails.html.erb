<div class="admin-content-inner">
  <h1 class="admin-page-title">
    <%= image_tag "admin-panel.svg", class: "admin-title-image", alt: "" %>
    Заявки
  </h1>

  <section class="admin-card">

    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Email</th>
            <th>Дата отправки</th>
            <th>Время отправки</th>
          </tr>
        </thead>

        <tbody>
          <% @emails.each do |email| %>
            <tr>
              <td><%= email.address %></td>
              <td><%= email.created_at.in_time_zone("Europe/Moscow").strftime("%d.%m.%Y") %></td>
              <td><%= email.created_at.in_time_zone("Europe/Moscow").strftime("%H:%M:%S") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</div>
