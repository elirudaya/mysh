<h1>Заявки с заглушки</h1>

<table>
  <thead>
    <tr>
      <th>Email</th>
      <th>Дата отправки</th>
      <th>Время отправки</th>
    </tr>
  </thead>

  <tbody>
    <% @emails.each do |email| %>
      <tr>
        <td><%= email.address %></td>
        <td><%= email.created_at.strftime("%d.%m.%Y") %></td>
        <td><%= email.created_at.strftime("%H:%M:%S") %></td>
      </tr>
    <% end %>
  </tbody>
</table>