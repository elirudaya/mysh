<h1>Панель администратора</h1>

<h2>Статистика</h2>

<ul>
  <li>Пользователей: <strong><%= @users_count %></strong></li>
  <li>Постов: <strong><%= @posts_count %></strong></li>
  <li>Заявок с заглушки: <strong><%= @emails_count %></strong></li>
</ul>

<hr>

<h2>Последние посты</h2>

<% @posts.each do |post| %>
  <p>
    <%= link_to post.title, post_path(post) %>
    — <%= post.user.email %>
  </p>
<% end %>

<p><%= link_to "Все посты", admin_posts_path %></p>

<hr>

<h2>Последние пользователи</h2>

<% @users.each do |user| %>
  <p>
    <%= user.email %>
    — <%= user.admin? ? "Администратор" : "Пользователь" %>
  </p>
<% end %>

<p><%= link_to "Все пользователи", admin_users_path %></p>
<p><%= link_to "Заявки с заглушки", admin_emails_path %></p>