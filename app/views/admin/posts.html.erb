<h1>Все посты</h1>

<% if @posts.any? %>
  <% @posts.each do |post| %>
    <article>
      <h2><%= link_to post.title, post_path(post) %></h2>
      <p>Автор: <%= post.user.email %></p>
      <p><%= post.body %></p>

      <%= button_to "Удалить пост",
            post_path(post),
            method: :delete,
            data: { turbo_confirm: "Удалить этот пост?" } %>

      <hr>
    </article>
  <% end %>
<% else %>
  <p>Постов пока нет</p>
<% end %>